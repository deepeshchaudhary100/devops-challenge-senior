# =============================================================================
# SECRETS TEMPLATE — Copy to secrets.tfvars and fill in your values
# =============================================================================
# DO NOT commit secrets.tfvars to version control!
#
# Usage:
#   cp secrets.tfvars.example secrets.tfvars
#   # Edit secrets.tfvars with your values
#   terraform plan  -var-file="secrets.tfvars"
#   terraform apply -var-file="secrets.tfvars"
# =============================================================================

# Docker Hub credentials for pulling container images
dockerhub_username = "your-dockerhub-username"
dockerhub_password = "your-dockerhub-password-or-access-token"

# GCP authentication is handled via:
#   gcloud auth application-default login
#
# For CI/CD, store these as GitHub Secrets:
#   DOCKERHUB_USERNAME — Your Docker Hub username
#   DOCKERHUB_TOKEN    — Your Docker Hub access token
#   GCP_SA_KEY         — Base64-encoded GCP service account key JSON
#   GCP_PROJECT_ID     — Your GCP project ID
